# Example pcb2gcode settings for the Makera Carvera (FR4 1.6 mm, single-sided).
# A STARTING POINT - tool sizes, depths and speeds depend on your bits and material. Calibrate before relying on it.
# Feeds/speeds: Makera "PCB" tool presets.
# Use: pcb2gcode --config millproject_carvera --back B_Cu.gbr --drill x.drl --outline Edge_Cuts.gbr --output-dir out
# then: python3 main.py --pcb2gcode out -o board.nc --preview --max-depth 2.2

metric=true
metricoutput=true
zero-start=true
optimise=0.005mm
tolerance=0.005
nog64=true
zsafe=1.0
zchange=10.0
spinup-time=0
software=custom

# --- isolation: 30deg V-bit at Z-0.10.
#     mill-diameters = the groove width the bit REALLY cuts at zwork (tip + 2*depth*tan(angle/2) + runout).
#     Measure it: mill a test board and compare track/pad widths with the design, then adjust.
#     Too small a value -> tracks come out thinner than designed.
mill-diameters=0.25mm
milling-overlap=10%
isolation-width=0.44mm
zwork=-0.10
mill-feed=500
mill-vertfeed=200
mill-speed=12000

# --- drills 0.8 / 1.0 / 1.4 mm (diameter:min-hole-offset:max-hole-offset)
drills-available=0.8mm:-0.8mm:+0.05mm,1.0mm:-0.15mm:+0.05mm,1.4mm:-0.35mm:+0.149mm
# drill tip (118deg) is about 0.3 x D long: 1.6 board + tip + margin -> -2.1 (needs --max-depth 2.2 in main.py)
zdrill=-2.1
drill-feed=200
drill-speed=10000
nog81=true
# holes >= 1.55 mm are milled with a 1 mm corn mill
min-milldrill-hole-diameter=1.55mm
milldrill-diameter=1.0mm
zmilldrill=-1.7

# --- outline: 2 mm corn mill, 0.3 mm per pass, 4 tabs 1.5 mm wide, 0.6 mm high. Inside corners get r = 1 mm.
#     With milled holes (1 mm mill) plus a 2 mm outline mill you may exceed 5 tools - then use 1 mm for both.
cutter-diameter=2.0mm
zcut=-1.7
cut-infeed=0.3
cut-feed=500
cut-vertfeed=300
cut-speed=12000
bridges=1.5mm
bridgesnum=4
zbridges=-1.0
